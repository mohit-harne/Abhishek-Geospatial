---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ThreeGeoBackground from '../components/ThreeGeoBackground.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "IMAGIS: Advanced Geospatial Solutions, Drone Photogrammetry, DGPS Surveys, Orthomosaics, DTM/DSM Terrain Modeling."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | IMAGIS Geospatial Surveys</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="relative bg-slate-950 text-slate-100 min-h-screen overflow-x-hidden">
    <ThreeGeoBackground />
    <Navbar />
    <main class="relative z-10 pt-20">
      <slot />
    </main>
    <Footer />
  </body>
</html>