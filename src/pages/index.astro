---
import Layout from '../layouts/Layout.astro';

const metrics = [
  { value: '120k+', label: 'Hectares Mapped' },
  { value: '±1.5cm', label: 'Horizontal RMS Error' },
  { value: '850+', label: 'Completed Missions' },
  { value: '100%', label: 'DGCA Certified UAV Fleet' }
];

const surveyHighlights = [
  {
    title: 'DGPS Geodetic Baseline',
    desc: 'Dual-frequency RTK/PPK GNSS receivers generating high-order control grids for national highways, rail corridors, and mining boundaries.',
    tag: 'Millimeter Scale',
    img: 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=800&q=80'
  },
  {
    title: 'High-Altitude UAV Photogrammetry',
    desc: 'Heavy-lift multi-rotor and fixed-wing UAVs fitted with full-frame RTK sensors capturing sub-centimeter GSD imagery.',
    tag: 'Aerial Intelligence',
    img: 'https://images.unsplash.com/photo-1508614589041-895b88991e3e?auto=format&fit=crop&w=800&q=80'
  },
  {
    title: 'True-Orthomosaic Generation',
    desc: 'Distortion-free aerial mapping mosaics calibrated with ground control stations, seamless color balancing, and UTM coordinates.',
    tag: 'Sub-Pixel GSD',
    img: 'https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&fit=crop&w=800&q=80'
  },
  {
    title: 'DTM, DSM & 3D Point Mesh',
    desc: 'Algorithmic point cloud filtering removing vegetation and structures to derive bare-earth surfaces for hydrological and cut/fill modeling.',
    tag: 'Elevation Models',
    img: 'https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&w=800&q=80'
  }
];

const processSteps = [
  { step: '01', title: 'Mission Planning & Geodetic Base', desc: 'DGCA airspace permits, baseline calibration, and dual-frequency DGPS benchmark setup.' },
  { step: '02', title: 'Aerial Photogrammetry / LiDAR', desc: 'Autonomous high-density flight operations with 80% overlap and onboard RTK logging.' },
  { step: '03', title: 'Point Cloud & Ortho Engine', desc: 'Dense stereo-matching, point cloud classification, seamline optimization, and elevation modeling.' },
  { step: '04', title: 'CAD/GIS Vectorization & QA', desc: 'Independent GCP validation, contour generation, cut/fill earthwork reports, and certified handover.' }
];
---

<Layout title="Autonomous Aerial Surveying & Geomatics Engineering">
  <!-- Hero Section -->
  <section class="min-h-[90vh] flex items-center justify-center relative px-6 py-24 z-10">
    <div class="max-w-5xl mx-auto text-center space-y-8">
      <div class="hero-badge inline-flex items-center gap-2 px-4 py-2 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 text-xs font-semibold uppercase tracking-widest backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
        Next-Gen Geomatics & Aerial Remote Sensing
      </div>

      <h1 class="hero-title text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white leading-tight">
        Millimeter Precision. <br />
        <span class="bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-500 bg-clip-text text-transparent">
          Planetary Resolution.
        </span>
      </h1>

      <p class="hero-desc text-base sm:text-lg md:text-xl text-slate-400 max-w-3xl mx-auto leading-relaxed">
        ABK engineers enterprise LiDAR, RTK DGPS ground networks, and UAV photogrammetry to provide actionable digital surface models and infrastructure analytics.
      </p>

      <div class="hero-cta flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a href="/services" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-semibold text-sm uppercase tracking-wider shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:scale-105 transition-all">
          Explore Survey Spectrum
        </a>
        <a href="/contact" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/80 border border-slate-700 hover:border-cyan-500/50 text-slate-200 font-semibold text-sm uppercase tracking-wider transition-all">
          Request GIS Quote
        </a>
      </div>
    </div>
  </section>

  <!-- Metrics Ribbon -->
  <section class="metrics-section relative z-10 border-y border-slate-800/80 bg-slate-950/70 backdrop-blur-md py-12">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8">
      {metrics.map((m) => (
        <div class="metric-card text-center space-y-1">
          <div class="text-3xl md:text-4xl font-black text-cyan-400 tracking-tight">{m.value}</div>
          <div class="text-xs uppercase tracking-widest text-slate-400 font-medium">{m.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Survey Highlights Section -->
  <section id="competencies-section" class="py-28 px-6 max-w-7xl mx-auto relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-xs font-bold uppercase tracking-widest text-cyan-400 mb-2">Core Competencies</h2>
      <p class="text-3xl md:text-4xl font-extrabold text-white">Full-Spectrum Geodetic Surveys</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {surveyHighlights.map((survey) => (
        <div class="survey-card group relative overflow-hidden rounded-2xl bg-slate-900/70 border border-slate-800 hover:border-cyan-500/50 transition-all duration-500 flex flex-col justify-between shadow-xl">
          <div class="relative h-64 overflow-hidden">
            <img 
              src={survey.img} 
              alt={survey.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 filter brightness-90 contrast-110" 
              loading="lazy" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
            <span class="absolute top-4 right-4 bg-slate-950/80 border border-cyan-400/40 text-cyan-300 text-[11px] font-bold px-3 py-1 rounded-full uppercase tracking-wider backdrop-blur-md">
              {survey.tag}
            </span>
          </div>
          <div class="p-8 space-y-4">
            <h3 class="text-2xl font-bold text-white group-hover:text-cyan-400 transition-colors">{survey.title}</h3>
            <p class="text-sm text-slate-400 leading-relaxed">{survey.desc}</p>
            <a href="/services" class="inline-flex items-center gap-2 text-xs font-semibold text-cyan-400 hover:text-cyan-300 uppercase tracking-widest pt-2">
              Learn Technical Specifications &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Precision Workflow Section -->
  <section class="py-24 px-6 max-w-7xl mx-auto relative z-10 border-t border-slate-800/80">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-xs font-bold uppercase tracking-widest text-cyan-400 mb-2">Standard Operating Procedure</h2>
      <p class="text-3xl md:text-4xl font-extrabold text-white">End-to-End Survey Workflow</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {processSteps.map((step) => (
        <div class="workflow-card p-6 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-cyan-500/40 transition-all duration-300 flex flex-col justify-between">
          <div class="text-3xl font-black text-cyan-500/30 mb-4">{step.step}</div>
          <h3 class="text-lg font-bold text-white mb-2">{step.title}</h3>
          <p class="text-xs text-slate-400 leading-relaxed">{step.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-20 px-6 max-w-7xl mx-auto relative z-10">
    <div class="rounded-3xl bg-gradient-to-r from-cyan-950/80 via-slate-900/90 to-blue-950/80 border border-cyan-500/30 p-10 md:p-16 text-center space-y-6 backdrop-blur-md">
      <h2 class="text-3xl md:text-4xl font-extrabold text-white">Need Centimeter-Accurate Mapping for Your Project?</h2>
      <p class="text-slate-400 max-w-2xl mx-auto text-sm sm:text-base leading-relaxed">
        Whether it is a state highway corridor, mining volume estimation, or town planning DTM, our survey team deploys on-site across India.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="px-8 py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs uppercase tracking-widest shadow-lg shadow-cyan-500/25 transition-all">
          Transmit Site Coordinates
        </a>
        <a href="/projects" class="px-8 py-3.5 rounded-xl bg-slate-900 border border-slate-700 hover:border-slate-500 text-white font-semibold text-xs uppercase tracking-widest transition-all">
          View Completed Works
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initAnimations = () => {
    // Hero Entrance
    const heroTl = gsap.timeline();
    heroTl
      .from('.hero-badge', { y: 20, opacity: 0, duration: 0.6, ease: 'power2.out' })
      .from('.hero-title', { y: 35, opacity: 0, duration: 0.8, ease: 'power3.out' }, '-=0.3')
      .from('.hero-desc', { y: 25, opacity: 0, duration: 0.7, ease: 'power2.out' }, '-=0.4')
      .from('.hero-cta', { y: 20, opacity: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3');

    // Metrics Counter & Ribbon
    gsap.from('.metric-card', {
      scrollTrigger: {
        trigger: '.metrics-section',
        start: 'top 85%',
        once: true
      },
      y: 30,
      opacity: 0,
      stagger: 0.12,
      duration: 0.7,
      ease: 'power3.out'
    });

    // Survey Competency Cards (Per-card trigger to prevent sticky hidden states)
    const cards = document.querySelectorAll('.survey-card');
    cards.forEach((card) => {
      gsap.from(card, {
        scrollTrigger: {
          trigger: card,
          start: 'top 92%',
          once: true
        },
        y: 40,
        opacity: 0,
        duration: 0.75,
        ease: 'power3.out'
      });
    });

    // Workflow Steps
    const workflowCards = document.querySelectorAll('.workflow-card');
    workflowCards.forEach((item) => {
      gsap.from(item, {
        scrollTrigger: {
          trigger: item,
          start: 'top 92%',
          once: true
        },
        y: 30,
        opacity: 0,
        duration: 0.6,
        ease: 'power2.out'
      });
    });

    // Force ScrollTrigger to calculate exact offsets once elements render
    ScrollTrigger.refresh();
  };

  // Run on initial load and handle Astro page transitions if enabled
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initAnimations();
  } else {
    window.addEventListener('DOMContentLoaded', initAnimations);
  }

  // Recalculate once images and external assets finish loading
  window.addEventListener('load', () => {
    ScrollTrigger.refresh();
  });
</script>