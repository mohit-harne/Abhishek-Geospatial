---
import Layout from '../layouts/Layout.astro';

const principles = [
  { title: 'Rigorous Geodetic Calibration', desc: 'Every mission connects to sovereign benchmark monuments and precise GNSS satellite constellations.' },
  { title: 'Zero Data Compromise', desc: 'Point clouds, DTMs, and orthomosaics undergo dual-tier peer review and ground check-point validation.' },
  { title: 'Certified Aerial Safety', desc: 'DGCA-licensed remote pilots with full airworthiness clearances and zero-accident telemetry records.' }
];
---

<Layout title="About Us & Founder | IMAGIS Geospatial">
  <section class="py-24 px-6 max-w-7xl mx-auto space-y-24">
    <!-- About Story -->
    <div class="about-hero max-w-3xl mx-auto text-center space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-cyan-400">Institutional Heritage</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white">Engineering The Ground Reality</h1>
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        IMAGIS was founded to bridge the divide between theoretical GIS modeling and practical civil engineering. Combining RTK survey engineering with aerial drone remote sensing, we replace estimation with verified ground truth.
      </p>
    </div>

    <!-- Founder Section -->
    <div class="founder-card rounded-2xl bg-gradient-to-r from-slate-900/80 to-slate-950 border border-cyan-500/30 p-8 md:p-14 grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
      <div class="md:col-span-5 relative">
        <div class="w-full h-80 rounded-xl overflow-hidden border border-slate-700 shadow-2xl relative">
          <img 
            src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=800&q=80" 
            alt="Founder & Chief Surveyor" 
            class="w-full h-full object-cover filter brightness-95" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
        </div>
      </div>
      <div class="md:col-span-7 space-y-5">
        <span class="text-xs uppercase tracking-widest text-cyan-400 font-bold">Leadership & Vision</span>
        <h2 class="text-3xl font-extrabold text-white">Chief Surveyor & Managing Director</h2>
        <p class="text-sm text-slate-300 leading-relaxed">
          "Geospatial engineering is the quiet bedrock of all infrastructure. Whether laying rail tracks across arid terrain or calculating river reservoir capacity, a single centimeter of deviation compounds into millions in project overrun. At IMAGIS, precision is our standard."
        </p>
        <div class="pt-4 border-t border-slate-800 flex items-center gap-6">
          <div>
            <div class="font-bold text-white text-base">Er. Executive Director</div>
            <div class="text-xs text-cyan-400">M.Tech Geoinformatics, Licensed Surveyor</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Core Values -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {principles.map((item) => (
        <div class="principle-box p-8 rounded-xl bg-slate-900/30 border border-slate-800 space-y-3">
          <h3 class="text-lg font-bold text-white">{item.title}</h3>
          <p class="text-xs text-slate-400 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.about-hero', { y: 30, opacity: 0, duration: 0.8, ease: 'power2.out' });
  gsap.from('.founder-card', {
    scrollTrigger: { trigger: '.founder-card', start: 'top 80%' },
    scale: 0.96,
    opacity: 0,
    duration: 1,
    ease: 'power3.out'
  });
  gsap.from('.principle-box', {
    scrollTrigger: { trigger: '.principle-box', start: 'top 85%' },
    y: 30,
    opacity: 0,
    stagger: 0.15,
    duration: 0.8,
    ease: 'power2.out'
  });
</script>