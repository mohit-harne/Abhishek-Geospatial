---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: 'Interstate Expressway Corridor Survey',
    client: 'National Highways Infrastructure',
    scope: '145 km Drone Photogrammetry + DGPS Monumentation',
    accuracy: '±1.8 cm RMSE Horizontal, ±2.5 cm Vertical',
    img: 'https://images.unsplash.com/photo-1545558014-8692077e9b5c?auto=format&fit=crop&w=800&q=80'
  },
  {
    title: '500 MW Solar Photovoltaic Park Topography',
    client: 'Clean Energy Power Grid',
    scope: '1,200 Hectares DTM Surface Model & Hydrological Runoff',
    accuracy: '±2.0 cm GSD with DSM Flow Direction Analysis',
    img: 'https://images.unsplash.com/photo-1509391365360-2e959784a276?auto=format&fit=crop&w=800&q=80'
  },
  {
    title: 'River Basin Catchment & Siltation Modeling',
    client: 'Water Resources Dept',
    scope: 'Bathymetric Echo Sounding + UAV Shoreline DEM',
    accuracy: '0.1m Contour Interval with Capacity Curve Computations',
    img: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=800&q=80'
  }
];
---

<Layout title="Projects & Case Studies | IMAGIS Surveys">
  <section class="py-24 px-6 max-w-7xl mx-auto">
    <div class="projects-hero text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-cyan-400">Field Portfolio</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-3">Mission Deployments</h1>
      <p class="text-slate-400 mt-4 leading-relaxed">
        High-impact geomatics projects completed with centimeter-grade accuracy for government corporations and industrial leaders.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {projects.map((proj) => (
        <div class="project-card rounded-2xl bg-slate-900/50 border border-slate-800 overflow-hidden hover:border-cyan-500/50 transition-all duration-300 flex flex-col">
          <div class="h-56 overflow-hidden relative">
            <img src={proj.img} alt={proj.title} class="w-full h-full object-cover filter brightness-90 hover:scale-110 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <span class="text-[10px] uppercase tracking-widest text-cyan-400 font-bold">{proj.client}</span>
              <h3 class="text-xl font-bold text-white mt-1">{proj.title}</h3>
              <p class="text-xs text-slate-400 mt-2 font-mono">Scope: {proj.scope}</p>
            </div>
            <div class="pt-4 border-t border-slate-800">
              <span class="text-[11px] uppercase tracking-wider text-slate-500 block">Verified Accuracy</span>
              <span class="text-xs font-semibold text-sky-300 font-mono">{proj.accuracy}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.projects-hero', {
    y: 35,
    opacity: 0,
    duration: 0.9,
    ease: 'power2.out'
  });

  gsap.from('.project-card', {
    scrollTrigger: {
      trigger: '.project-card',
      start: 'top 85%'
    },
    y: 45,
    opacity: 0,
    stagger: 0.2,
    duration: 0.8,
    ease: 'power3.out'
  });
</script>