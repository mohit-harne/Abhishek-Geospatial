---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    id: 'dgps',
    name: 'Differential Global Positioning System (DGPS)',
    summary: 'Sub-centimeter geodetic reference stations and control networks for highway corridors, smart cities, and land titles.',
    specs: ['Dual-frequency GNSS (GPS, GLONASS, Galileo, BeiDou)', 'Static & RTK baselines with mm accuracy', 'Autonomous base setups with CORS tie-ins'],
    output: 'WGS84 & UTM coordinates, XYZ control monument reports'
  },
  {
    id: 'drone',
    name: 'Industrial UAV & Drone Photogrammetry',
    summary: 'Autonomous UAV operations mapped with optical RGB and multispectral payloads for large acreage topographic surveys.',
    specs: ['DGCA compliant type-certified drones', 'GSD ranging from 1.0 cm to 3.5 cm per pixel', 'Equipped with PPK/RTK onboard triggers'],
    output: 'Geotagged raw imagery, flight trajectory logs, camera calibration matrices'
  },
  {
    id: 'ortho',
    name: 'True-Orthomosaic Generation',
    summary: 'Orthorectified spatial maps corrected for terrain relief displacement, tilt, and optical distortions.',
    specs: ['Rigorous seamline optimization and radiometric balancing', 'Seamless tiling with world file projections', 'Coordinate systems: EPSG:4326, EPSG:32643, etc.'],
    output: 'GeoTIFF, ECW, Google Earth KML/KMZ tiles'
  },
  {
    id: 'dtm-dsm',
    name: 'Digital Terrain (DTM) & Digital Surface Models (DSM)',
    summary: 'High-density 3D surface and bare-earth elevation data for hydrology, earthwork calculations, and cut/fill analysis.',
    specs: ['Point cloud classification (Ground, Vegetation, Built-up)', 'Contour generation from 0.25m to 1.0m intervals', 'Volumetric computation with slope classification'],
    output: 'LAS/LAZ point clouds, DEM raster grids, 3D DXF contours'
  },
  {
    id: 'lidar',
    name: 'Airborne & Mobile LiDAR Scanning',
    summary: 'Direct laser range pulses piercing through dense forest canopies for powerline corridor and mining topography.',
    specs: ['Multi-return laser pulses up to 2,000,000 pts/sec', 'Integrated IMU and geodetic GNSS sensors', 'Accurate elevation mapping under vegetated cover'],
    output: 'Dense 3D point cloud with RGB colorization, vector wireframes'
  },
  {
    id: 'hydro',
    name: 'Bathymetric & Hydrographic Sounding',
    summary: 'Underwater seabed and riverbed topographic surveys using single and dual-frequency echo sounders coupled with DGPS.',
    specs: ['Acoustic depth sounders from 0.5m to 200m depth', 'Sub-bottom profiling for reservoir siltation', 'Synchronized real-time GPS coordinate logging'],
    output: 'Depth contour charts, reservoir capacity curves, bathymetric XYZ grids'
  }
];
---

<Layout title="Geospatial Survey Spectrum | DGPS, Drone, Ortho, DTM & DSM">
  <section class="py-24 px-6 max-w-7xl mx-auto">
    <div class="service-header text-center max-w-3xl mx-auto mb-20">
      <span class="text-xs font-bold uppercase tracking-widest text-cyan-400">Technical Catalog</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-3">Geomatics Engineering Services</h1>
      <p class="text-slate-400 mt-4 leading-relaxed">
        From geodetic baselines to high-resolution aerial photogrammetry, our surveys comply with national survey standards, offering certified accuracy for infrastructure developers.
      </p>
    </div>

    <div class="space-y-12">
      {services.map((item, idx) => (
        <div class="service-row group p-8 md:p-12 rounded-2xl bg-slate-900/40 border border-slate-800 hover:border-cyan-500/40 transition-all duration-300 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-1 text-3xl font-black text-cyan-500/40 group-hover:text-cyan-400 transition-colors">
            0{idx + 1}
          </div>
          <div class="lg:col-span-5 space-y-3">
            <h2 class="text-2xl font-bold text-white group-hover:text-cyan-300 transition-colors">{item.name}</h2>
            <p class="text-sm text-slate-400 leading-relaxed">{item.summary}</p>
          </div>
          <div class="lg:col-span-3 space-y-2 border-l border-slate-800 pl-6">
            <span class="text-[11px] font-bold uppercase tracking-wider text-cyan-400">Key Parameters</span>
            <ul class="text-xs text-slate-400 space-y-1 list-disc list-inside">
              {item.specs.map(spec => (
                <li>{spec}</li>
              ))}
            </ul>
          </div>
          <div class="lg:col-span-3 space-y-2 border-l border-slate-800 pl-6">
            <span class="text-[11px] font-bold uppercase tracking-wider text-sky-400">Standard Deliverables</span>
            <p class="text-xs text-slate-300 font-mono leading-relaxed">{item.output}</p>
            <a href="/contact" class="inline-block mt-2 text-xs font-semibold text-cyan-400 hover:text-white uppercase tracking-wider">
              Request Specific Proposal &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.service-header', {
    y: 40,
    opacity: 0,
    duration: 1,
    ease: 'power3.out'
  });

  gsap.utils.toArray('.service-row').forEach((row: any) => {
    gsap.from(row, {
      scrollTrigger: {
        trigger: row,
        start: 'top 85%',
      },
      x: -40,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out'
    });
  });
</script>