---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Request Geodetic Survey Quotation | IMAGIS">
  <section class="py-24 px-6 max-w-7xl mx-auto">
    <div class="contact-header text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-cyan-400">Connect With Engineers</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white mt-3">Deploy Survey Mission</h1>
      <p class="text-slate-400 mt-4 leading-relaxed">
        Submit your project coordinates, expected GSD, and timeline. Our geodetic team responds within 24 hours with flight feasibility and equipment allocations.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Contact Form -->
      <div class="lg:col-span-6 bg-slate-900/60 border border-slate-800 p-8 sm:p-10 rounded-2xl backdrop-blur-md">
        <form class="space-y-6" onsubmit="event.preventDefault(); alert('Inquiry logged successfully. Our chief surveyor will reach out.');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs uppercase tracking-wider text-slate-300 font-semibold mb-2">Full Name</label>
              <input type="text" required placeholder="John Doe" class="w-full bg-slate-950/80 border border-slate-700 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-400" />
            </div>
            <div>
              <label class="block text-xs uppercase tracking-wider text-slate-300 font-semibold mb-2">Corporate Email</label>
              <input type="email" required placeholder="name@company.com" class="w-full bg-slate-950/80 border border-slate-700 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-400" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs uppercase tracking-wider text-slate-300 font-semibold mb-2">Phone Number</label>
              <input type="tel" required placeholder="+91 98765 43210" class="w-full bg-slate-950/80 border border-slate-700 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-400" />
            </div>
            <div>
              <label class="block text-xs uppercase tracking-wider text-slate-300 font-semibold mb-2">Survey Type</label>
              <select class="w-full bg-slate-950/80 border border-slate-700 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-400">
                <option>UAV Drone Photogrammetry</option>
                <option>DGPS Geodetic Control Network</option>
                <option>DTM / DSM & Volume Calculations</option>
                <option>Airborne LiDAR Scanning</option>
                <option>Bathymetric Sounding</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider text-slate-300 font-semibold mb-2">Site Location / Coordinates (Lat, Long)</label>
            <input type="text" placeholder="e.g. 20.9458° N, 77.7660° E (or Area in Hectares)" class="w-full bg-slate-950/80 border border-slate-700 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-400" />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider text-slate-300 font-semibold mb-2">Scope & Project Details</label>
            <textarea rows="4" placeholder="Detail the expected deliverables, required horizontal/vertical accuracy, and access constraints..." class="w-full bg-slate-950/80 border border-slate-700 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-cyan-400"></textarea>
          </div>

          <button type="submit" class="w-full py-4 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-bold text-xs uppercase tracking-widest shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 transition-all">
            Transmit Survey Mission Brief
          </button>
        </form>
      </div>

      <!-- Map & Office Coordinates -->
      <div class="lg:col-span-6 space-y-6">
        <div class="w-full h-80 rounded-2xl overflow-hidden border border-slate-800 shadow-2xl relative">
          <!-- Google Maps Iframe Embed with Dark Canvas filter -->
          <iframe 
            src="https://maps.google.com/maps?q=Maharashtra,%20India&t=k&z=12&ie=UTF8&iwloc=&output=embed" 
            class="w-full h-full filter invert contrast-125 hue-rotate-180" 
            loading="lazy">
          </iframe>
          <div class="absolute top-4 left-4 bg-slate-950/90 border border-cyan-500/40 px-3 py-1.5 rounded-lg text-xs font-mono text-cyan-300 backdrop-blur-md">
            WGS84 Reference Base: Active
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-6 rounded-xl bg-slate-900/40 border border-slate-800 space-y-1">
            <span class="text-[10px] uppercase tracking-widest text-cyan-400 font-bold">Dispatch Center</span>
            <p class="text-sm font-semibold text-white">Central Operations Lab</p>
            <p class="text-xs text-slate-400">Maharashtra Geodetic Division, India</p>
          </div>
          <div class="p-6 rounded-xl bg-slate-900/40 border border-slate-800 space-y-1">
            <span class="text-[10px] uppercase tracking-widest text-cyan-400 font-bold">Direct Dispatch</span>
            <p class="text-sm font-semibold text-white">+91 93701 57780</p>
            <p class="text-xs text-slate-400">Mon - Sat: 08:00 - 19:00 IST</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';

  gsap.from('.contact-header', {
    y: 30,
    opacity: 0,
    duration: 0.9,
    ease: 'power2.out'
  });
</script>