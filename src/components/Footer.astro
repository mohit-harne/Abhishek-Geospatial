---
const currentYear = new Date().getFullYear();
---
<footer class="relative z-10 bg-slate-950/80 border-t border-slate-800 text-slate-400 pt-16 pb-10">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 rounded bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center font-black text-white text-sm">
          ABK
        </div>
        <span class="font-bold text-lg text-white">ABHISHEK</span>
      </div>
      <p class="text-sm leading-relaxed text-slate-400 mb-6">
        Precision engineering geospatial solutions. Delivering high-resolution DTM/DSM terrain models, airborne LiDAR, orthomosaic surveys, and millimeter-accurate DGPS control networks.
      </p>
    </div>

    <div>
      <h3 class="text-white text-xs font-bold tracking-widest uppercase mb-4 text-cyan-400">Core Capabilities</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/services" class="hover:text-cyan-400 transition-colors">DGPS Geodetic Control</a></li>
        <li><a href="/services" class="hover:text-cyan-400 transition-colors">UAV Drone Mapping</a></li>
        <li><a href="/services" class="hover:text-cyan-400 transition-colors">Orthomosaic Generation</a></li>
        <li><a href="/services" class="hover:text-cyan-400 transition-colors">DTM & DSM Extraction</a></li>
        <li><a href="/services" class="hover:text-cyan-400 transition-colors">Bathymetry & Hydrographic</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white text-xs font-bold tracking-widest uppercase mb-4 text-cyan-400">Quick Links</h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/about" class="hover:text-cyan-400 transition-colors">About ABK</a></li>
        <li><a href="/projects" class="hover:text-cyan-400 transition-colors">Featured Projects</a></li>
        <li><a href="/contact" class="hover:text-cyan-400 transition-colors">GIS Project Inquiry</a></li>
        <li><a href="/contact" class="hover:text-cyan-400 transition-colors">Request Accuracy Report</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white text-xs font-bold tracking-widest uppercase mb-4 text-cyan-400">Headquarters</h3>
      <p class="text-sm leading-relaxed mb-3">
        Geodetic Operations Division, Trade & Industrial Center, Maharashtra, India.
      </p>
      <p class="text-sm text-slate-300">Email: <span class="text-cyan-400">contact@abhishekgeospatial.com</span></p>
      <p class="text-sm text-slate-300">Phone: <span class="text-cyan-400">+91 94231 45067</span></p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 pt-8 border-t border-slate-900 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500">
    <p>&copy; {currentYear} ABHISHEK Geospatial Solutions. All Rights Reserved.</p>
    <div class="flex gap-6 mt-4 md:mt-0">
      <a href="#" class="hover:text-slate-400">Privacy Policy</a>
      <a href="#" class="hover:text-slate-400">Terms of Service</a>
      <a href="#" class="hover:text-slate-400">Geodetic Accreditations</a>
    </div>
  </div>
</footer>